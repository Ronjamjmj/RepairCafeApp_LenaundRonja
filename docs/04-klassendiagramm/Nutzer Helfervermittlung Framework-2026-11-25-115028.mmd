classDiagram
    direction TB

    %% ===== INTERFACES =====
    class Benachrichtigbar {
        <<interface>>
        +sendeNachricht(empfaenger: Kontaktangabe, inhalt: String) Boolean
        +planeErinnerung(termin: Termin, vorlaufStunden: Integer) void
    }

    class Exportierbar {
        <<interface>>
        +exportiereAlsCsv() File
        +exportiereAlsPdf() File
    }

    class Bewertbar {
        <<interface>>
        +bewertungHinzufuegen(bewertung: Bewertung) void
        +berechneDurchschnitt() Double
    }

    %% ===== NUTZER & KONTAKT (GENERALISIERUNG 1) =====
    class Nutzer {
        -String nutzerId
        -String name
        -String postleitzahl
        -Set~RollenTyp~ rollen
        -Set~Fachgebiet~ fachgebiete
        +registrieren() Boolean
        +hatRolle(rolle: RollenTyp) Boolean
        +bewertungHinzufuegen(bewertung: Bewertung) void
        +berechneDurchschnitt() Double
    }

    class Benutzerkonto {
        -String kontoId
        -String passwortHash
        -Boolean istAktiv
        -DateTime erstelltAm
        +anmelden() Boolean
        +kontoLoeschen() void
    }

    class Kontaktangabe {
        <<abstract>>
        #Boolean istPrimaer
        #Boolean verifiziert
        +validieren()* Boolean
    }

    class Telefonnummer {
        -String vorwahl
        -String rufnummer
        -Boolean smsFaehig
        +validieren() Boolean
    }

    class EmailAdresse {
        -String adresse
        +validieren() Boolean
    }

    %% ===== SKILLS & ASSOZIATIONSKLASSE =====
    class Skill {
        -String skillId
        -String bezeichnung
        -Fachgebiet fachgebiet
    }

    class Kompetenzprofil {
        <<association class>>
        -String erfahrungsLevel
        -Date geprueftAm
        +freigeben() void
    }

    %% ===== REPARATURANFRAGE & GERÄT =====
    class Reparaturanfrage {
        -String anfrageId
        -DateTime erstelltAm
        -String problemBeschreibung
        -List~String~ fehlerbilder
        -AnfrageStatus status
        +helferZuweisen(helfer: Nutzer) void
        +statusAktualisieren(neu: AnfrageStatus) void
    }

    class Geraet {
        -String geraetId
        -Geraetekategorie kategorie
        -String modellbezeichnung
        -String hersteller
    }

    class Foto {
        -String fotoId
        -String dateiname
        -String speicherpfad
        -FotoArt art
    }

    class Ersatzteilempfehlung {
        -String empfehlungId
        -String ersatzteilname
        -Double richtpreis
        -Boolean istVorhanden
        +alsVorhandenMarkieren() void
    }

    class Bewertung {
        -String bewertungId
        -Integer sterne
        -String kommentar
        -Date datum
    }

    %% ===== TERMINE (GENERALISIERUNG 2) =====
    class Termin {
        <<abstract>>
        #String terminId
        #Date datum
        #Time startzeit
        #Integer dauerMinuten
        #String ort
        #TerminStatus status
        +buchen(anfrage: Reparaturanfrage) Boolean
        +absagen() void
    }

    class Diagnosetermin {
        -String befund
        -Boolean reparaturLohntSich
        -Boolean sofortRepariert
        +diagnoseErfassen(befund: String, lohntSich: Boolean) void
    }

    class Reparaturtermin {
        -String durchgefuehrteArbeiten
        -Boolean reparaturErfolgreich
        +reparaturAbschliessen() void
    }

    class CafeTermin {
        -String veranstaltungstitel
        -Integer maxPlaetze
        +auslastungBerechnen() Double
    }

    %% ===== BENACHRICHTIGUNG & AUSWERTUNG =====
    class Benachrichtigung {
        -String nachrichtId
        -String inhalt
        -DateTime versandZeitpunkt
        -Boolean zugestellt
        +sendeNachricht(empfaenger: Kontaktangabe, inhalt: String) Boolean
        +planeErinnerung(termin: Termin, vorlaufStunden: Integer) void
    }

    class Auswertung {
        -String auswertungId
        -Date zeitraumVon
        -Date zeitraumBis
        -Integer anzahlReparaturen
        -Double erfolgsquote
        +exportiereAlsCsv() File
        +exportiereAlsPdf() File
    }

    %% ===== VERERBUNG (GENERALISIERUNG) =====
    Kontaktangabe <|-- Telefonnummer
    Kontaktangabe <|-- EmailAdresse

    Termin <|-- Diagnosetermin
    Termin <|-- Reparaturtermin
    Termin <|-- CafeTermin

    %% ===== REALISIERUNG & NUTZUNG (INTERFACES) =====
    Bewertbar <|.. Nutzer
    Benachrichtigbar <|.. Benachrichtigung
    Exportierbar <|.. Auswertung

    Termin ..> Benachrichtigbar : nutzt
    Nutzer ..> Exportierbar : nutzt
    Bewertung ..> Bewertbar : nutzt

    %% ===== KOMPOSITIONEN & AGGREGATIONEN =====
    Nutzer "1" *--> "1" Benutzerkonto : besitzt
    Nutzer "1" *--> "1..*" Kontaktangabe : hat
    Nutzer "0..*" o-- "0..*" Skill : beherrscht
    Nutzer .. Kompetenzprofil
    Skill .. Kompetenzprofil

    Reparaturanfrage "1" *--> "0..*" Foto : dokumentiert durch
    Reparaturanfrage "1" *--> "0..*" Ersatzteilempfehlung : enthaelt
    Reparaturanfrage "1" *--> "0..2" Termin : terminiert ueber

    CafeTermin "0..1" o--> "0..*" Termin : buendelt

    %% ===== ASSOZIATIONEN =====
    Nutzer "1" --> "0..*" Reparaturanfrage : erstellt
    Nutzer "0..1" --> "0..*" Reparaturanfrage : bearbeitet
    Nutzer "1" --> "0..*" Termin : hat Verfuegbarkeit
    Reparaturanfrage "0..*" --> "1" Geraet : betrifft
    Reparaturanfrage "1" --> "0..1" Bewertung : erhaelt
    Termin "1" --> "0..*" Benachrichtigung : loest aus
    Auswertung "0..*" ..> "1..*" Reparaturanfrage : wertet aus