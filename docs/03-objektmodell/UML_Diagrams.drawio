        <mxCell id="bfJCYtvz4LieY8Nh1W1s-1" value="&lt;h1&gt;Klassen&lt;/h1&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Helfer&lt;/li&gt;&lt;li&gt;Hilfesuchende&lt;/li&gt;&lt;li&gt;Technische Leitung&amp;nbsp;&lt;/li&gt;&lt;li&gt;Reparaturanfrage&lt;/li&gt;&lt;li&gt;Gerät&amp;nbsp;&lt;/li&gt;&lt;li&gt;(Benutzerkonto)&lt;/li&gt;&lt;li&gt;Foto&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
