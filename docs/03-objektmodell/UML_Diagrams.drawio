        </mxCell>
        <mxCell id="kXXXcoIe1fRVXpVaZckE-8" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration: underline;&quot;&gt;&lt;b&gt;kaffemaschine1 : Gerät&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;gerätekategorie = KÜCHENGERÄT&lt;br&gt;ausgewähltesGerät = &quot;Kaffemaschine&quot;&lt;br&gt;problem = &quot;Pumpt kein Wasser, Macht laute Geräusche&quot;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="580" y="760" width="190" height="130" as="geometry" />
        </mxCell>
        <mxCell id="C7IE53GGY-9xMpSiWtym-1" value="&lt;p dir=&quot;ltr&quot; style=&quot;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Was im Objektdiagramm steht&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;ul dir=&quot;ltr&quot; style=&quot;&quot;&gt;&lt;li style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;strong style=&quot;&quot;&gt;konkreter Zeitpunkt:&lt;/strong&gt;&amp;nbsp;fachliche Prüfung abgeschlossen &amp;amp; an Helfer zugewiesen&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;strong style=&quot;&quot;&gt;Instanzen:&lt;/strong&gt; Jeder Kasten ist ein konkretes Objekt, mit Kopf &lt;code dir=&quot;ltr&quot; style=&quot;&quot;&gt;objektname : Klassenname&lt;/code&gt;, unterstrichen.&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;strong style=&quot;&quot;&gt;Attributbereich:&lt;/strong&gt; Attribute mit konkreten Werten, z. B. &lt;code dir=&quot;ltr&quot; style=&quot;&quot;&gt;name = &quot;…&quot;&lt;/code&gt;. Ein Datentyp steht dort normalerweise nicht.&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;strong style=&quot;&quot;&gt;Verbindungen:&lt;/strong&gt; Einfache Linien (Links) zwischen den Instanzen.&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;strong style=&quot;&quot;&gt;Nicht dabei:&lt;/strong&gt; Methodenbereich und Multiplizitäten. Beides gehört zur Klasse bzw. zur Beziehung zwischen Klassen.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p dir=&quot;ltr&quot; style=&quot;&quot;&gt;&lt;font size=&quot;3&quot;&gt;Der Klassenname steht trotzdem im Kopf jedes Objekts. Ihr müsst also wissen, welcher Typ hinter jedem Objekt steckt, zeichnet aber keine Klassen. Verben aus eurer Tabelle (z. B. „Einladung“ als „verb“) kommen nur ins Diagramm, wenn es dazu ein Objekt gibt, das gespeichert wird&lt;/font&gt;&lt;/p&gt;" style="text;whiteSpace=wrap;html=1;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="180" y="30" width="630" height="350" as="geometry" />
        </mxCell>
        <mxCell id="DH4Y_vJLoea9VIxZHzzL-1" value="&lt;h1&gt;Objekte&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 10px; font-weight: normal;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;- Ergebnis von Klasse + Instanz: den Klassen wird je eine Instanz zugewiesen&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;h1&gt;&lt;/h1&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="17" y="340" width="140" height="130" as="geometry" />
        </mxCell>
        <mxCell id="yU6a0nN7URztnFiVjanr-1" value="&lt;h1&gt;Instanzen&lt;/h1&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;reparatur1&lt;/span&gt;&lt;/li&gt;&lt;li&gt;diagnose1&lt;/li&gt;&lt;li&gt;termin1&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="5" y="40" width="150" height="120" as="geometry" />
        </mxCell>
        <mxCell id="bfJCYtvz4LieY8Nh1W1s-1" value="&lt;h1&gt;Klassen&lt;/h1&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Helfer&lt;/li&gt;&lt;li&gt;Hilfesuchende&lt;/li&gt;&lt;li&gt;Technische Leitung&amp;nbsp;&lt;/li&gt;&lt;li&gt;Reparaturanfrage&lt;/li&gt;&lt;li&gt;Gerät&amp;nbsp;&lt;/li&gt;&lt;li&gt;(Benutzerkonto)&lt;/li&gt;&lt;li&gt;Foto&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
